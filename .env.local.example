# Supabase (Postgres)
# Dashboard → Project Settings → API
# SUPABASE_URL: Project URL (https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: service_role key (solo server, nunca exponer en el cliente)
# Antes de usar: ejecutar supabase/schema.sql en el SQL Editor
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth
NEXTAUTH_SECRET=generate_a_random_secret_here
# Solo desarrollo local. En Vercel NO configures NEXTAUTH_URL:
# define AUTH_URL con tu dominio (https://tu-dominio.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# Admin credentials (comma-separated for multiple admins)
ADMIN_EMAILS=comunicacionesuniempresarial@gmail.com
ADMIN_PASSWORDS=your_secure_password_here

# ── Deploy en Vercel ──
# En Vercel NO uses NEXTAUTH_URL; usa AUTH_URL con tu dominio de producción:
#   AUTH_URL=https://tu-futuro-dual.vercel.app
# Las demás vars (SUPABASE_*, NEXTAUTH_SECRET, ADMIN_*) van tal cual en
# Settings → Environment Variables, marcadas como Sensitive.
# VERCEL_URL la inyecta Vercel automáticamente (no la setees).